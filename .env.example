# Zwift Credentials
ZWIFT_EMAIL=your_zwift_email
ZWIFT_PASSWORD=your_zwift_password

# Sync Settings
SYNC_TIME_WINDOW=1_week
SYNC_CRON=0 2 * * *

# Web Server Port (default: 8087)
PORT=8087

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Directory Paths (Optional Overrides)
# DATA_DIR=/data
# STATE_DIR=/data/config
# WATCH_DIR=/data/downloads
